include ../MatekG474/hwdef.inc

# --------------------- PWM -----------------------
PA0  TIM2_CH1  TIM2 PWM(1)  GPIO(50)
PA1  TIM2_CH2  TIM2 PWM(2)  GPIO(51)
PA2  TIM2_CH3  TIM2 PWM(3)  GPIO(52)
PA3  TIM2_CH4  TIM2 PWM(4)  GPIO(53)
PA6  TIM3_CH1  TIM3 PWM(5)  GPIO(54)
PA7  TIM3_CH2  TIM3 PWM(6)  GPIO(55)
PB0  TIM3_CH3  TIM3 PWM(7)  GPIO(56)
PB1  TIM3_CH4  TIM3 PWM(8)  GPIO(57)
PC6  TIM8_CH1  TIM8 PWM(9)  GPIO(58)
PB9  TIM8_CH3  TIM8 PWM(10) GPIO(59)
PB2  TIM5_CH1  TIM5 PWM(11) GPIO(60)

define AP_PERIPH_RC_OUT_ENABLED 1
define AP_PERIPH_NOTIFY_ENABLED 1

# enable ESC control
define HAL_SUPPORT_RCOUT_SERIAL 1
define HAL_WITH_ESC_TELEM 1

# --------------------- I2C temperature/humidity sensor (SHT3x/SHT4x) --------
define AP_TEMPERATURE_SENSOR_ENABLED 1
define AP_TEMPERATURE_SENSOR_MAX_INSTANCES 1
define AP_PERIPH_DEVICE_TEMPERATURE_ENABLED 1

# The shared MatekG474 base disables the I2C stuck-bus recovery helper
# (HAL_I2C_CLEAR_ON_TIMEOUT, on by default in AP_HAL_ChibiOS) with no
# stated reason, and no shipped MatekG474 firmware has ever actually
# used I2C to exercise it. Re-enable it here: a device that times out
# holding SDA low would otherwise never be recovered by the driver.
undef HAL_I2C_CLEAR_ON_TIMEOUT
define HAL_I2C_CLEAR_ON_TIMEOUT 1

# Disable DMA for I2C and run it in polling mode instead. STM32G4 has no
# explicit STM32_I2C_USE_DMA default in this codebase (unlike several H7
# boards that explicitly disable it after hitting I2C+DMA issues), and no
# shipped MatekG474 firmware has ever exercised I2C+DMA on this hwdef to
# prove it works here. Matches the NODMA I2C* pattern used by those boards.
NODMA I2C*
define STM32_I2C_USE_DMA FALSE

# TEMPORARY: I2C bus scan printed over TX1/RX1 at boot, for SHT3x/SHT4x
# hardware bring-up. Remove once the sensor wiring/address is confirmed.
define AP_PERIPH_I2C_SCAN_DEBUG 1
